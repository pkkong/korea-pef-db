# Naver News Search API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Optional email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Optional Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional AI enrichment for public 3-line summaries and category audit
# local keeps publishing independent of external AI tools.
NEWSLETTER_AI_PROVIDER=local
# To use NotebookLM CLI after installing notebooklm-mcp-cli and running `nlm login`:
# NEWSLETTER_AI_PROVIDER=notebooklm
# NEWSLETTER_NLM_BIN=nlm
# NEWSLETTER_NLM_PROFILE=default
# Optional: reuse a specific notebook. Leave blank to create/reuse KPEF Newsletter Review YYYY-MM-DD.
# NEWSLETTER_NOTEBOOKLM_NOTEBOOK_ID=
# One date review should ask NotebookLM once.
# NEWSLETTER_NOTEBOOKLM_REVIEW_QUERY_LIMIT=1
# NEWSLETTER_AI_STRICT=0
# Keep 0 so NotebookLM failures fall back to local-rule enrichment.
# Set 1 to apply validated AI section_suggestion to the public article section.
# NEWSLETTER_AI_APPLY_SECTIONS=0
