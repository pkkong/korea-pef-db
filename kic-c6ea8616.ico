<script>
function goToPreviousPage() {
    var previousPage = '';

    if (previousPage && previousPage.trim() !== '') {
        // 이전 페이지 정보가 있으면 해당 페이지로 이동
        window.location.href = previousPage;
    } else {
        window.location.href = '/';
    }
}
</script>
