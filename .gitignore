# Local secrets
config/*.env
!config/*.env.example
services/newsletter/config/*.env
!services/newsletter/config/*.env.example
.env
.env.*

# Local databases
db/*.db
db/*.sqlite
db/*.sqlite3
*.db
*.sqlite
*.sqlite3

# Downloaded source files and crawl cache
data/raw/**
!data/raw/
!data/raw/**/
!data/raw/**/.gitkeep

# Generated outputs
exports/
logs/
dashboard/data/*.json
dashboard/pef_dashboard_standalone.html
public/
public/data/*.json
deploy/newsletter/site/
deploy/newsletter/*.zip
deploy/newsletter/deploy-manifest.json
services/newsletter/deploy/site/
services/newsletter/deploy/*.zip
services/newsletter/deploy/deploy-manifest.json
tmp/

# Runtime logs
*.log
*.out.log
*.err.log

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# One-off spreadsheet working files
*.xls
*.xlsx
~$*

# Public Vercel delivery copy. This is the verified 2025Q4 GP ranking data pack,
# deliberately versioned so the mobile download route is deployable.
!services/newsletter/web/downloads/
!services/newsletter/web/downloads/gp_ranking_datapack_2025YE.xlsx

# Official FSS PEF workbooks are the reproducible input to GP analytics. They
# are deliberately versioned because the upstream board can become unavailable.
!data/raw/fss_pef/
!data/raw/fss_pef/*.xls
!data/raw/fss_pef/*.xlsx

# Local SQL regression runtime
node_modules/
